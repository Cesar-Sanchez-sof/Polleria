# agents-service: variables de entorno. En Render se cargan en el panel (Environment); en local, en agents-service/.env.
# Genera los secretos con: python -c "import secrets; print(secrets.token_hex(32))"

# Token que el proxy del ERP envía en X-Internal-Token (mismo valor que AGENTS_SERVICE_INTERNAL_TOKEN de Next.js)
AGENTS_SERVICE_INTERNAL_TOKEN=
# Clave HS256 de la identidad firmada (P-9); mismo valor que AI_ASSISTANT_IDENTITY_KEY de Next.js y distinta del token
AI_ASSISTANT_IDENTITY_KEY=

# Conexión del rol ai_readonly (solo SELECT); distinta de DATABASE_URL del ERP
DATABASE_URL_READONLY=

# Agente Gemini (Google AI Studio). Opcional: GEMINI_MODEL (por defecto gemini-3.5-flash), AI_GEMINI_SQL_TIMEOUT_S (1-40)
AI_GEMINI_SQL=1
GEMINI_API_KEY=
GEMINI_MODEL=

# Agente GPT OSS vía Groq. Opcional: GROQ_MODEL (por defecto openai/gpt-oss-120b), AI_GROQ_SQL_TIMEOUT_S (1-40)
AI_GROQ_SQL=1
GROQ_API_KEY=
GROQ_MODEL=

# Opcionales
# AGENTS_SERVICE_ALLOWED_HOSTS=polleria-agents-service.onrender.com   # restringe la cabecera Host
# AGENTS_SERVICE_ALLOWED_USER_IDS=1,2                                 # ids del ERP autorizados (cuentas evaluadoras)
# AGENTS_SERVICE_HOST=127.0.0.1 / AGENTS_SERVICE_PORT=8002            # solo en local (Render fija PORT)
