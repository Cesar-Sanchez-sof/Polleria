{
  "name": "polleria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx prisma/seed.ts --auto",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "prestart": "tsx prisma/seed.ts --auto",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:black-box": "vitest run test/black-box",
    "test:white-box": "vitest run test/white-box",
    "test:integration": "vitest run test/integration",
    "test:concurrency": "vitest run test/white-box/concurrency",
    "test:smoke": "tsx test/smoke/dashboard-smoke.ts",
    "test:smoke:hr": "node test/smoke/hr-security-smoke.mjs",
    "test:load:local": "node test/load/local-stress-suite.mjs",
    "test:load:break": "node test/load/local-stress-suite.mjs --mode=stress",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:reset": "tsx scripts/backup-db.ts && tsx prisma/reset-db.ts --yes && tsx prisma/seed.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "db:seed:hr": "tsx prisma/seed-hr-demo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
