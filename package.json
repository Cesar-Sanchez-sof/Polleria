    "@dnd-kit/core": "^6.3.1",
    "@prisma/client": "^6.19.3",
    "@shadcn/react": "^0.3.1",
    "@types/react-grid-layout": "^1.3.6",
    "@upstash/redis": "^1.39.0",
    "@xmldom/xmldom": "^0.8.10",
    "@xyflow/react": "^12.12.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.5.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-colorful": "^5.8.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-grid-layout": "^2.3.0",
    "react-resizable-panels": "^4.13.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml-crypto": "^6.0.0",
    "xmlbuilder2": "^3.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/adm-zip": "^0.5.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^26.0.0",
    "openapi-types": "^12.1.3",
    "prisma": "^6.12.0",
    "shadcn": "^1.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "js-yaml": "^4.1.0",
    "minimatch": "^11.0.1"
  }
