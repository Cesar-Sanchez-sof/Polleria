# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (NEON POSTGRESQL)
# ==============================================================================
# Obtén tu connection string desde la consola de Neon (Dashboard -> Connection Details)
DATABASE_URL=

# ==============================================================================
# AUTENTICACIÓN Y SEGURIDAD
# ==============================================================================
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=

# ==============================================================================
# CONSULTA DE DOCUMENTOS (DNI / RUC - json.pe)
# ==============================================================================
# Token gratuito u oficial de json.pe (si no se define, usa fallback simulado)
JSON_PE_TOKEN=

# ==============================================================================
# ALMACENAMIENTO DE COMPROBANTES (S3 / NEON OBJECT STORAGE / CLOUDFLARE R2)
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ENDPOINT_URL_S3=

# ==============================================================================
# PASARELA DE PAGO (MERCADO PAGO)
# ==============================================================================
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# ==============================================================================
# CACHE / RATE LIMITING (UPSTASH REDIS)
# ==============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================================================================
# ASISTENTE DE IA (el globo aparece siempre; sin modelos muestra "No hay modelos disponibles")
# ==============================================================================
# --- Modelo R (LoRA / ai-service) ---
# Demostración local (se ignora con NODE_ENV=production): poner 1
AI_ASSISTANT_DEMO=
# Evaluación en Vercel (VERCEL_ENV=preview): poner 1
AI_ASSISTANT_EVAL_ENABLED=
# Local: http://127.0.0.1:<puerto>. Evaluación: túnel https (trycloudflare o ngrok del proyecto)
AI_SERVICE_URL=
# Hex de 32 bytes o más (64+ caracteres); el mismo valor que usa ai-service
AI_SERVICE_INTERNAL_TOKEN=
# Hex de 32 bytes o más, distinta del token interno (firma la identidad de cada consulta)
AI_ASSISTANT_IDENTITY_KEY=
# Ids de usuario ADMIN evaluadores separados por comas (obligatorio en Vercel con datos reales)
AI_ASSISTANT_EVAL_USER_IDS=
# 1 solo en pruebas controladas con datos reales (exige AI_ASSISTANT_IDENTITY_KEY)
AI_ASSISTANT_REAL_DATA=

# --- Gemini (conversación general, sin datos del ERP) ---
GEMINI_API_KEY=
# Opcional; por defecto gemini-3.5-flash
GEMINI_MODEL=

# --- GPT Luna (OpenAI; conversación general, sin datos del ERP) ---
# La misma clave la usa ai-service si AI_LLM_PROVIDER=openai
OPENAI_API_KEY=
# Opcional; por defecto gpt-6-luna
OPENAI_MODEL=

# --- ai-service (Python): variables del servicio, no de Next.js ---
# Intérprete del resultado del LoRA: simulado (por defecto) u openai
AI_LLM_PROVIDER=
AI_SQL_GENERATOR=

# ==============================================================================
# FACTURACIÓN ELECTRÓNICA SUNAT (UBL 2.1)
# ==============================================================================
# RUC del emisor para pruebas (Default: 20000000001)
SUNAT_RUC=20000000001
# Usuario y clave secundarios SOL para entorno Beta de SUNAT
SUNAT_USER=MODDATOS
SUNAT_PASSWORD=moddatos
# Web Service Beta de SUNAT para emisión de comprobantes
SUNAT_ENDPOINT=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
# (Opcional) Certificado digital .pem para producción (en Beta se genera par demo en memoria)
SUNAT_CERT_PEM=
SUNAT_PRIVATE_KEY_PEM=
