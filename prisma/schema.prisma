// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------
enum PersonType {
  Natural
  Legal

  @@map("person_type")
}

enum PurchaseOrderStatus {
  Pending
  PartiallyReceived
  FullyReceived
  Cancelled

  @@map("purchase_order_status")
}

enum PurchaseReceiptStatus {
  Confirmed
  Voided

  @@map("purchase_receipt_status")
}

enum SupplyType {
  RawMaterial
  FinishedProduct

  @@map("supply_type")
}

enum InventoryMovementType {
  Purchase
  TransformationOut
  TransformationIn
  Sale
  Shrinkage
  Adjustment
  InformalPurchase

  @@map("inventory_movement_type")
}

// =====================================================================
// MODULE 1: SECURITY & ACCESS CONTROL
// =====================================================================

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @db.VarChar(50)
  description String?          @db.VarChar(150)
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       User[]

  @@map("role")
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  String           @db.VarChar(100)
  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  permissionId Int        @map("permission_id")
  roleId       Int        @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "uq_role_permission")
  @@index([roleId], map: "idx_role_permission_role")
  @@index([permissionId], map: "idx_role_permission_permission")
  @@map("role_permission")
}

model Shift {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(30)
  date      DateTime   @db.Date
  startTime DateTime   @map("start_time") @db.Time
  endTime   DateTime   @map("end_time") @db.Time
  employees Employee[]

  @@map("shift")
}

model Employee {
  id                 Int                @id @default(autoincrement())
  shiftId            Int?               @map("shift_id")
  dni                String             @unique @db.VarChar(8)
  firstName          String             @map("first_name") @db.VarChar(50)
  middleName         String?            @map("middle_name") @db.VarChar(50)
  paternalLastName   String             @map("paternal_last_name") @db.VarChar(50)
  maternalLastName   String?            @map("maternal_last_name") @db.VarChar(50)
  phone              String?            @db.VarChar(9)
  address            String?            @db.VarChar(200)
  birthDate          DateTime?          @map("birth_date") @db.Date
  hireDate           DateTime           @default(now()) @map("hire_date") @db.Date
  position           String?            @db.VarChar(30)
  area               String?            @db.VarChar(30)
  contractType       String?            @map("contract_type") @db.VarChar(30)
  baseSalary         Decimal            @default(0) @map("base_salary") @db.Decimal(10, 2)
  active             Boolean            @default(true)
  shift              Shift?             @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  users              User[]
  payrolls           Payroll[]
  purchaseOrders     PurchaseOrder[]
  purchaseReceipts   PurchaseReceipt[]
  transformations    Transformation[]
  informalPurchases  InformalPurchase[]

  @@index([shiftId], map: "idx_employee_shift")
  @@map("employee")
}

model User {
  id               Int       @id @default(autoincrement())
  employeeId       Int       @map("employee_id")
  roleId           Int       @map("role_id")
  username         String    @unique @db.VarChar(20)
  password         String    @db.VarChar(255)
  failedAttempts   Int       @default(0) @map("failed_attempts")
  locked           Boolean   @default(false)
  lockedAt         DateTime? @map("locked_at") @db.Timestamp(6)
  lastAccessAt     DateTime? @map("last_access_at") @db.Timestamp(6)
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role             Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([employeeId], map: "idx_user_employee")
  @@index([roleId], map: "idx_user_role")
  @@map("app_user")
}

// =====================================================================
// MODULE 2: HUMAN RESOURCES (PAYROLL)
// =====================================================================

model Payroll {
  id             Int            @id @default(autoincrement())
  employeeId     Int            @map("employee_id")
  month          Int            @db.SmallInt
  year           Int            @db.SmallInt
  baseSalary     Decimal        @map("base_salary") @db.Decimal(7, 2)
  overtimePay    Decimal        @default(0) @map("overtime_pay") @db.Decimal(7, 2)
  bonus          Decimal        @default(0) @db.Decimal(7, 2)
  deductions     Decimal        @default(0) @db.Decimal(7, 2)
  netPay         Decimal        @map("net_pay") @db.Decimal(7, 2)
  paymentDate    DateTime?      @map("payment_date") @db.Date
  active         Boolean        @default(true)
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([employeeId, month, year], map: "uq_payroll_period")
  @@index([employeeId], map: "idx_payroll_employee")
  @@map("payroll")
}

// =====================================================================
// MODULE 3: PURCHASES & SUPPLIERS
// =====================================================================

model Supplier {
  id               Int              @id @default(autoincrement())
  ruc              String           @unique @db.VarChar(11)
  tradeName        String?          @map("trade_name") @db.VarChar(150)
  businessName     String           @map("business_name") @db.VarChar(150)
  name             String?          @db.VarChar(100)
  contactPerson    String?          @map("contact_person") @db.VarChar(100)
  address          String?          @db.VarChar(150)
  phone            String?          @db.VarChar(9)
  email            String?          @db.VarChar(80)
  active           Boolean          @default(true)
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]

  @@map("supplier")
}

model PaymentType {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(30)
  active           Boolean           @default(true)
  purchasePayments PurchasePayment[]
  salesPayments    SalesPayment[]

  @@map("payment_type")
}

model PurchaseOrder {
  id            Int                 @id @default(autoincrement())
  supplierId    Int                 @map("supplier_id")
  employeeId    Int                 @map("employee_id")
  orderNumber   String              @unique @map("order_number") @db.VarChar(20)
  issuedAt      DateTime            @default(now()) @map("issued_at") @db.Date
  expectedAt    DateTime?           @map("expected_at") @db.Date
  status        PurchaseOrderStatus @default(Pending)
  subtotal      Decimal             @default(0) @db.Decimal(7, 2)
  igv           Decimal             @default(0) @db.Decimal(7, 2)
  total         Decimal             @default(0) @db.Decimal(7, 2)
  notes         String?             @db.VarChar(200)
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  employee      Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items         PurchaseOrderItem[]
  receipts      PurchaseReceipt[]

  @@index([supplierId], map: "idx_purchase_order_supplier")
  @@index([employeeId], map: "idx_purchase_order_employee")
  @@map("purchase_order")
}

model Supply {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(50)
  type              SupplyType          @default(RawMaterial)
  unitOfMeasure     String              @map("unit_of_measure") @db.VarChar(10)
  currentStock      Decimal             @default(0) @map("current_stock") @db.Decimal(10, 2)
  minimumStock      Decimal             @default(0) @map("minimum_stock") @db.Decimal(10, 2)
  active            Boolean             @default(true)
  purchaseOrderItems PurchaseOrderItem[]
  inventoryMovements InventoryMovement[]
  transformationItems TransformationItem[]
  informalPurchases InformalPurchase[]
  dishRecipes       DishRecipe[]

  @@map("supply")
}

model PurchaseOrderItem {
  id            Int                  @id @default(autoincrement())
  purchaseOrderId Int                @map("purchase_order_id")
  supplyId      Int                  @map("supply_id")
  quantityOrdered Decimal            @map("quantity_ordered") @db.Decimal(10, 2)
  unitPrice     Decimal              @map("unit_price") @db.Decimal(10, 2)
  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supply        Supply               @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  receiptItems  PurchaseReceiptItem[]

  @@index([purchaseOrderId], map: "idx_purchase_order_item_order")
  @@index([supplyId], map: "idx_purchase_order_item_supply")
  @@map("purchase_order_item")
}

model PurchaseReceipt {
  id              Int                   @id @default(autoincrement())
  purchaseOrderId Int                   @map("purchase_order_id")
  receivedById    Int                   @map("received_by_id")
  receivedAt      DateTime              @default(now()) @map("received_at") @db.Timestamp(6)
  notes           String?               @db.VarChar(200)
  status          PurchaseReceiptStatus @default(Confirmed)
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedBy      Employee              @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  items           PurchaseReceiptItem[]
  invoices        PurchaseInvoice[]

  @@index([purchaseOrderId], map: "idx_purchase_receipt_order")
  @@index([receivedById], map: "idx_purchase_receipt_employee")
  @@map("purchase_receipt")
}

model PurchaseReceiptItem {
  id                   Int                @id @default(autoincrement())
  receiptId            Int                @map("receipt_id")
  purchaseOrderItemId  Int                @map("purchase_order_item_id")
  quantityReceived     Decimal            @map("quantity_received") @db.Decimal(10, 2)
  notes                String?            @db.VarChar(100)
  receipt              PurchaseReceipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem    PurchaseOrderItem  @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  inventoryMovements   InventoryMovement[]

  @@index([receiptId], map: "idx_purchase_receipt_item_receipt")
  @@index([purchaseOrderItemId], map: "idx_purchase_receipt_item_order_item")
  @@map("purchase_receipt_item")
}

model InventoryMovement {
  id                    Int                   @id @default(autoincrement())
  supplyId              Int                   @map("supply_id")
  purchaseReceiptItemId Int?                  @map("purchase_receipt_item_id")
  movementType          InventoryMovementType @map("movement_type")
  quantity              Decimal               @db.Decimal(10, 2)
  unitCost              Decimal?              @map("unit_cost") @db.Decimal(10, 2)
  reason                String?               @db.VarChar(100)
  movedAt               DateTime              @default(now()) @map("moved_at") @db.Timestamp(6)
  supply                Supply                @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  purchaseReceiptItem   PurchaseReceiptItem?  @relation(fields: [purchaseReceiptItemId], references: [id], onDelete: SetNull)

  @@index([supplyId], map: "idx_inventory_movement_supply")
  @@index([purchaseReceiptItemId], map: "idx_inventory_movement_receipt_item")
  @@map("inventory_movement")
}

model PurchaseInvoice {
  id             Int               @id @default(autoincrement())
  supplierId     Int               @map("supplier_id")
  receiptId      Int               @map("receipt_id")
  voucherType    String            @map("voucher_type") @db.VarChar(10)
  series         String            @db.VarChar(4)
  number         Int
  issuedAt       DateTime          @default(now()) @map("issued_at") @db.Date
  subtotal       Decimal           @default(0) @db.Decimal(7, 2)
  igv            Decimal           @default(0) @db.Decimal(7, 2)
  totalAmount    Decimal           @default(0) @map("total_amount") @db.Decimal(7, 2)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  active         Boolean           @default(true)
  supplier       Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  receipt        PurchaseReceipt   @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  payments       PurchasePayment[]
  journalEntries JournalEntry[]

  @@unique([supplierId, voucherType, series, number], map: "uq_purchase_invoice")
  @@index([supplierId], map: "idx_purchase_invoice_supplier")
  @@index([receiptId], map: "idx_purchase_invoice_receipt")
  @@map("purchase_invoice")
}

model PurchasePayment {
  id                Int             @id @default(autoincrement())
  purchaseInvoiceId Int             @map("purchase_invoice_id")
  paymentTypeId     Int             @map("payment_type_id")
  amount            Decimal         @db.Decimal(10, 2)
  paidAt            DateTime        @default(now()) @map("paid_at") @db.Timestamp(6)
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  paymentType       PaymentType     @relation(fields: [paymentTypeId], references: [id], onDelete: Restrict)

  @@index([purchaseInvoiceId], map: "idx_purchase_payment_invoice")
  @@index([paymentTypeId], map: "idx_purchase_payment_type")
  @@map("purchase_payment")
}

model Transformation {
  id        Int                  @id @default(autoincrement())
  employeeId Int                 @map("employee_id")
  date      DateTime             @default(now()) @db.Timestamp(6)
  notes     String?              @db.VarChar(200)
  employee  Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items     TransformationItem[]

  @@index([employeeId], map: "idx_transformation_employee")
  @@map("transformation")
}

model TransformationItem {
  id               Int            @id @default(autoincrement())
  transformationId Int            @map("transformation_id")
  supplyId         Int            @map("supply_id")
  itemType         String         @map("item_type") @db.VarChar(10)
  quantity         Decimal        @db.Decimal(10, 2)
  unitCost         Decimal?       @map("unit_cost") @db.Decimal(10, 2)
  transformation   Transformation @relation(fields: [transformationId], references: [id], onDelete: Cascade)
  supply           Supply         @relation(fields: [supplyId], references: [id], onDelete: Restrict)

  @@index([transformationId], map: "idx_transformation_item_transformation")
  @@index([supplyId], map: "idx_transformation_item_supply")
  @@map("transformation_item")
}

model InformalPurchase {
  id                   Int      @id @default(autoincrement())
  supplyId             Int      @map("supply_id")
  employeeId           Int      @map("employee_id")
  quantity             Decimal  @db.Decimal(10, 2)
  amountPaid           Decimal  @map("amount_paid") @db.Decimal(10, 2)
  date                 DateTime @default(now()) @db.Date
  informalPlaceOrVendor String? @map("informal_place_or_vendor") @db.VarChar(150)
  reason               String?  @db.VarChar(150)
  supply               Supply   @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  employee             Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([supplyId], map: "idx_informal_purchase_supply")
  @@index([employeeId], map: "idx_informal_purchase_employee")
  @@map("informal_purchase")
}

// =====================================================================
// MODULE 4: SALES & CUSTOMER SERVICE
// =====================================================================

model Customer {
  id            Int            @id @default(autoincrement())
  documentNumber String        @map("document_number") @db.VarChar(11)
  firstName     String         @map("first_name") @db.VarChar(100)
  lastName      String?        @map("last_name") @db.VarChar(100)
  phone         String?        @db.VarChar(20)
  personType    PersonType     @default(Natural) @map("person_type")
  active        Boolean        @default(true)
  salesInvoices SalesInvoice[]

  @@unique([personType, documentNumber], map: "uq_customer_document")
  @@map("customer")
}

model DiningTable {
  id      Int          @id @default(autoincrement())
  number  Int          @unique @db.SmallInt
  capacity Int         @default(4) @db.SmallInt
  active  Boolean      @default(true)
  orders  OrderTable[]

  @@map("dining_table")
}

model Dish {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(100)
  description String?     @db.Text
  price       Decimal     @db.Decimal(7, 2)
  active      Boolean     @default(true)
  orderItems  OrderItem[]
  recipes     DishRecipe[]

  @@map("dish")
}

model DishRecipe {
  id               Int     @id @default(autoincrement())
  dishId           Int     @map("dish_id")
  supplyId         Int     @map("supply_id")
  quantityRequired Decimal @map("quantity_required") @db.Decimal(10, 2)
  dish             Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  supply           Supply  @relation(fields: [supplyId], references: [id], onDelete: Restrict)

  @@unique([dishId, supplyId], map: "uq_dish_recipe_supply")
  @@index([dishId], map: "idx_dish_recipe_dish")
  @@index([supplyId], map: "idx_dish_recipe_supply")
  @@map("dish_recipe")
}

model SalesOrder {
  id            Int            @id @default(autoincrement())
  code          String         @unique @db.VarChar(20)
  orderType     String         @map("order_type") @db.VarChar(10)
  orderedAt     DateTime       @default(now()) @map("ordered_at") @db.Timestamp(6)
  status        String         @default("Pending") @db.VarChar(15)
  tables        OrderTable[]
  items         OrderItem[]
  salesInvoices SalesInvoice[]

  @@map("sales_order")
}

model OrderTable {
  id        Int         @id @default(autoincrement())
  tableId   Int         @map("table_id")
  orderId   Int         @map("order_id")
  notes     String?     @db.VarChar(100)
  table     DiningTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  order     SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tableId], map: "idx_order_table_table")
  @@index([orderId], map: "idx_order_table_order")
  @@map("order_table")
}

model OrderItem {
  id          Int        @id @default(autoincrement())
  orderId     Int        @map("order_id")
  dishId      Int        @map("dish_id")
  quantity    Int        @db.SmallInt
  unitPrice   Decimal    @map("unit_price") @db.Decimal(10, 2)
  subtotal    Decimal    @db.Decimal(10, 2)
  dishStatus  String     @default("Pending") @map("dish_status") @db.VarChar(30)
  notes       String?    @db.VarChar(100)
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish        Dish       @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_order_item_order")
  @@index([dishId], map: "idx_order_item_dish")
  @@map("order_item")
}

model SalesInvoice {
  id             Int            @id @default(autoincrement())
  orderId        Int            @map("order_id")
  customerId     Int            @map("customer_id")
  voucherType    String         @map("voucher_type") @db.VarChar(10)
  series         String         @db.VarChar(4)
  number         Int
  issuedAt       DateTime       @default(now()) @map("issued_at") @db.Date
  subtotal       Decimal        @default(0) @db.Decimal(10, 2)
  igv            Decimal        @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal        @default(0) @map("total_amount") @db.Decimal(10, 2)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  status         String         @default("Issued") @db.VarChar(15)
  order          SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments       SalesPayment[]
  journalEntries JournalEntry[]

  @@unique([voucherType, series, number], map: "uq_sales_invoice")
  @@index([orderId], map: "idx_sales_invoice_order")
  @@index([customerId], map: "idx_sales_invoice_customer")
  @@map("sales_invoice")
}

model SalesPayment {
  id             Int          @id @default(autoincrement())
  salesInvoiceId Int          @map("sales_invoice_id")
  paymentTypeId  Int          @map("payment_type_id")
  amount         Decimal      @db.Decimal(7, 2)
  paidAt         DateTime     @default(now()) @map("paid_at") @db.Timestamp(6)
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  paymentType    PaymentType  @relation(fields: [paymentTypeId], references: [id], onDelete: Restrict)

  @@index([salesInvoiceId], map: "idx_sales_payment_invoice")
  @@index([paymentTypeId], map: "idx_sales_payment_type")
  @@map("sales_payment")
}

// =====================================================================
// MODULE 5: ACCOUNTING
// =====================================================================

model AccountingAccount {
  id            Int                   @id @default(autoincrement())
  parentId      Int?                  @map("parent_id")
  code          String                @unique @db.VarChar(10)
  name          String                @db.VarChar(100)
  type          String                @db.VarChar(20)
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime              @default(now()) @map("updated_at") @db.Timestamp(6)
  parentAccount AccountingAccount?    @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  childAccounts AccountingAccount[]   @relation("AccountHierarchy")
  entryDetails  JournalEntryDetail[]

  @@index([parentId], map: "idx_accounting_account_parent")
  @@map("accounting_account")
}

model JournalEntry {
  id                Int                  @id @default(autoincrement())
  salesInvoiceId    Int?                 @map("sales_invoice_id")
  purchaseInvoiceId Int?                 @map("purchase_invoice_id")
  payrollId         Int?                 @map("payroll_id")
  entryDate         DateTime             @default(now()) @map("entry_date") @db.Date
  description       String               @db.VarChar(200)
  book              String               @default("Operaciones varias") @db.VarChar(60)
  responsible       String?              @db.VarChar(100)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime             @default(now()) @map("updated_at") @db.Timestamp(6)
  status            Boolean              @default(true)
  code              String               @unique @db.VarChar(20)
  observation       String?              @db.VarChar(200)
  salesInvoice      SalesInvoice?        @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  purchaseInvoice   PurchaseInvoice?     @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)
  payroll           Payroll?             @relation(fields: [payrollId], references: [id], onDelete: Restrict)
  entryDetails      JournalEntryDetail[]

  @@index([salesInvoiceId], map: "idx_journal_entry_sales_invoice")
  @@index([purchaseInvoiceId], map: "idx_journal_entry_purchase_invoice")
  @@index([payrollId], map: "idx_journal_entry_payroll")
  @@index([entryDate], map: "idx_journal_entry_date")
  @@index([book], map: "idx_journal_entry_book")
  @@index([status], map: "idx_journal_entry_status")
  @@map("journal_entry")
}

model JournalEntryDetail {
  id          Int               @id @default(autoincrement())
  entryId     Int               @map("entry_id")
  accountId   Int               @map("account_id")
  description String?           @db.VarChar(200)
  debit       Decimal           @default(0) @db.Decimal(12, 2)
  credit      Decimal           @default(0) @db.Decimal(12, 2)
  entry       JournalEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId], map: "idx_journal_entry_detail_entry")
  @@index([accountId], map: "idx_journal_entry_detail_account")
  @@map("journal_entry_detail")
}
