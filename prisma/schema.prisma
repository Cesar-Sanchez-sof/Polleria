// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------
enum PersonType {
  Natural
  Legal

  @@map("person_type")
}

enum PurchaseOrderStatus {
  Pending
  PartiallyReceived
  FullyReceived
  Cancelled

  @@map("purchase_order_status")
}

enum SupplyType {
  RawMaterial
  FinishedProduct

  @@map("supply_type")
}

enum InventoryMovementType {
  Purchase
  TransformationOut
  TransformationIn
  Sale
  Shrinkage
  Adjustment
  InformalPurchase

  @@map("inventory_movement_type")
}

enum AffectationIgv {
  Included
  Excluded

  @@map("affectation_igv")
}

// =====================================================================
// MODULE 1: SECURITY & ACCESS CONTROL
// =====================================================================

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique @db.VarChar(50)
  description String?          @db.VarChar(150)
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       User[]

  @@map("role")
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  String           @db.VarChar(100)
  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  permissionId Int        @map("permission_id")
  roleId       Int        @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "uq_role_permission")
  @@index([roleId], map: "idx_role_permission_role")
  @@index([permissionId], map: "idx_role_permission_permission")
  @@map("role_permission")
}

model Shift {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(30)
  date      DateTime   @db.Date
  startTime DateTime   @map("start_time") @db.Time
  endTime   DateTime   @map("end_time") @db.Time
  employees Employee[]

  @@map("shift")
}

model Employee {
  id                Int                @id @default(autoincrement())
  shiftId           Int?               @map("shift_id")
  dni               String             @unique @db.VarChar(8)
  firstName         String             @map("first_name") @db.VarChar(50)
  middleName        String?            @map("middle_name") @db.VarChar(50)
  paternalLastName  String             @map("paternal_last_name") @db.VarChar(50)
  maternalLastName  String?            @map("maternal_last_name") @db.VarChar(50)
  phone             String?            @db.VarChar(9)
  address           String?            @db.VarChar(200)
  birthDate         DateTime?          @map("birth_date") @db.Date
  hireDate          DateTime           @default(now()) @map("hire_date") @db.Date
  position          String?            @db.VarChar(30)
  area              String?            @db.VarChar(30)
  contractType      String?            @map("contract_type") @db.VarChar(30)
  baseSalary        Decimal            @default(0) @map("base_salary") @db.Decimal(10, 2)
  active            Boolean            @default(true)
  shift             Shift?             @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  users             User[]
  payrolls          Payroll[]
  purchaseOrders    PurchaseOrder[]
  receivedOrders    PurchaseOrder[]    @relation("ReceivedBy")
  transformations   Transformation[]
  informalPurchases InformalPurchase[]

  @@index([shiftId], map: "idx_employee_shift")
  @@map("employee")
}

model User {
  id                Int                @id @default(autoincrement())
  employeeId        Int                @map("employee_id")
  roleId            Int                @map("role_id")
  username          String             @unique @db.VarChar(20)
  correo            String?            @unique @db.VarChar(80)
  password          String             @db.VarChar(255)
  estado            Boolean            @default(true)
  failedAttempts    Int                @default(0) @map("failed_attempts")
  locked            Boolean            @default(false)
  lockedAt          DateTime?          @map("locked_at") @db.Timestamp(6)
  lastAccessAt      DateTime?          @map("last_access_at") @db.Timestamp(6)
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role              Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  accountingPeriods  AccountingPeriod[]
  closedPeriods      AccountingPeriod[] @relation("ClosedPeriods")
  cashSessionsOpened CashSession[]      @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[]      @relation("CashSessionClosedBy")

  @@index([employeeId], map: "idx_user_employee")
  @@index([roleId], map: "idx_user_role")
  @@map("app_user")
}

// =====================================================================
// MODULE 2: HUMAN RESOURCES (PAYROLL)
// =====================================================================

model Payroll {
  id             Int            @id @default(autoincrement())
  employeeId     Int            @map("employee_id")
  month          Int            @db.SmallInt
  year           Int            @db.SmallInt
  baseSalary     Decimal        @map("base_salary") @db.Decimal(7, 2)
  overtimePay    Decimal        @default(0) @map("overtime_pay") @db.Decimal(7, 2)
  bonus          Decimal        @default(0) @db.Decimal(7, 2)
  deductions     Decimal        @default(0) @db.Decimal(7, 2)
  netPay         Decimal        @map("net_pay") @db.Decimal(7, 2)
  paymentDate    DateTime?      @map("payment_date") @db.Date
  active         Boolean        @default(true)
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([employeeId, month, year], map: "uq_payroll_period")
  @@index([employeeId], map: "idx_payroll_employee")
  @@map("payroll")
}

// =====================================================================
// MODULE 3: PURCHASES & SUPPLIERS (unified flow)
// =====================================================================

model Supplier {
  id               Int               @id @default(autoincrement())
  ruc              String            @unique @db.VarChar(11)
  businessName     String            @map("business_name") @db.VarChar(150)
  contactPerson    String?           @map("contact_person") @db.VarChar(100)
  address          String?           @db.VarChar(150)
  phone            String?           @db.VarChar(9)
  email            String?           @db.VarChar(80)
  active           Boolean           @default(true)
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]

  @@map("supplier")
}

model PaymentType {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(30)
  active           Boolean           @default(true)
  purchasePayments PurchasePayment[]
  salesPayments    SalesPayment[]

  @@map("payment_type")
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  supplierId   Int                 @map("supplier_id")
  employeeId   Int                 @map("employee_id")
  receivedById Int?                @map("received_by_id")
  orderNumber  String              @unique @map("order_number") @db.VarChar(20)
  issuedAt     DateTime            @default(now()) @map("issued_at") @db.Date
  expectedAt   DateTime?           @map("expected_at") @db.Date
  receivedAt   DateTime            @default(now()) @map("received_at") @db.Timestamp(6)
  status       PurchaseOrderStatus @default(Pending)
  subtotal     Decimal             @default(0) @db.Decimal(7, 2)
  igv          Decimal             @default(0) @db.Decimal(7, 2)
  total        Decimal             @default(0) @db.Decimal(7, 2)
  notes        String?             @db.VarChar(200)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  receivedBy   Employee?           @relation("ReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  items        PurchaseOrderItem[]
  invoices     PurchaseInvoice[]

  @@index([supplierId], map: "idx_purchase_order_supplier")
  @@index([employeeId], map: "idx_purchase_order_employee")
  @@index([receivedById], map: "idx_purchase_order_received_by")
  @@map("purchase_order")
}

model Supply {
  id                  Int                    @id @default(autoincrement())
  name                String                 @db.VarChar(50)
  type                SupplyType             @default(RawMaterial)
  affectationIgv      AffectationIgv         @default(Excluded) @map("affectation_igv")
  unitOfMeasure       String                 @map("unit_of_measure") @db.VarChar(10)
  currentStock        Decimal                @default(0) @map("current_stock") @db.Decimal(10, 2)
  minimumStock        Decimal                @default(0) @map("minimum_stock") @db.Decimal(10, 2)
  lastCost            Decimal                @default(0) @map("last_cost") @db.Decimal(10, 2)
  averageCost         Decimal                @default(0) @map("average_cost") @db.Decimal(10, 2)
  active              Boolean                @default(true)
  purchaseOrderItems  PurchaseOrderItem[]
  inventoryMovements  InventoryMovement[]
  transformationItems TransformationItem[]
  informalPurchases   InformalPurchase[]
  dishRecipes         DishRecipe[]
  recipesProduced     TransformationRecipe[] @relation("RecipeProduced")
  recipesConsumed     TransformationRecipe[] @relation("RecipeConsumed")

  @@map("supply")
}

model PurchaseOrderItem {
  id                    Int                 @id @default(autoincrement())
  purchaseOrderId       Int                 @map("purchase_order_id")
  supplyId              Int                 @map("supply_id")
  quantityOrdered       Decimal             @map("quantity_ordered") @db.Decimal(10, 2)
  quantityReceived      Decimal?            @map("quantity_received") @db.Decimal(10, 2)
  unitPrice             Decimal             @map("unit_price") @db.Decimal(10, 2)
  affectationIgvApplied AffectationIgv      @default(Excluded) @map("affectation_igv_applied")
  subtotalLine          Decimal?            @map("subtotal_line") @db.Decimal(10, 2)
  igvLine               Decimal?            @map("igv_line") @db.Decimal(10, 2)
  finalAmountLine       Decimal?            @map("final_amount_line") @db.Decimal(10, 2)
  observation           String?             @db.VarChar(100)
  purchaseOrder         PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supply                Supply              @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  inventoryMovements    InventoryMovement[]

  @@index([purchaseOrderId], map: "idx_purchase_order_item_order")
  @@index([supplyId], map: "idx_purchase_order_item_supply")
  @@map("purchase_order_item")
}

model InventoryMovement {
  id                   Int                   @id @default(autoincrement())
  supplyId             Int                   @map("supply_id")
  purchaseOrderItemId  Int?                  @map("purchase_order_item_id")
  transformationItemId Int?                  @map("transformation_item_id")
  orderItemId          Int?                  @map("order_item_id")
  informalPurchaseId   Int?                  @map("informal_purchase_id")
  movementType         InventoryMovementType @map("movement_type")
  quantity             Decimal               @db.Decimal(10, 2)
  unitCost             Decimal?              @map("unit_cost") @db.Decimal(10, 2)
  reason               String?               @db.VarChar(100)
  movedAt              DateTime              @default(now()) @map("moved_at") @db.Timestamp(6)
  supply               Supply                @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  purchaseOrderItem    PurchaseOrderItem?    @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  transformationItem   TransformationItem?   @relation(fields: [transformationItemId], references: [id], onDelete: SetNull)
  orderItem            OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  informalPurchase     InformalPurchase?     @relation(fields: [informalPurchaseId], references: [id], onDelete: SetNull)

  @@index([supplyId], map: "idx_inventory_movement_supply")
  @@index([purchaseOrderItemId], map: "idx_inventory_movement_purchase_order_item")
  @@index([transformationItemId], map: "idx_inventory_movement_transformation_item")
  @@index([orderItemId], map: "idx_inventory_movement_order_item")
  @@index([informalPurchaseId], map: "idx_inventory_movement_informal_purchase")
  @@map("inventory_movement")
}

model PurchaseInvoice {
  id              Int               @id @default(autoincrement())
  supplierId      Int               @map("supplier_id")
  purchaseOrderId Int               @map("purchase_order_id")
  voucherType     String            @map("voucher_type") @db.VarChar(10)
  series          String            @db.VarChar(4)
  number          Int
  issuedAt        DateTime          @default(now()) @map("issued_at") @db.Date
  subtotal        Decimal           @default(0) @db.Decimal(7, 2)
  igv             Decimal           @default(0) @db.Decimal(7, 2)
  totalAmount     Decimal           @default(0) @map("total_amount") @db.Decimal(7, 2)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  active          Boolean           @default(true)
  supplier        Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  payments        PurchasePayment[]
  journalEntries  JournalEntry[]

  @@unique([supplierId, voucherType, series, number], map: "uq_purchase_invoice")
  @@index([supplierId], map: "idx_purchase_invoice_supplier")
  @@index([purchaseOrderId], map: "idx_purchase_invoice_purchase_order")
  @@map("purchase_invoice")
}

model PurchasePayment {
  id                Int             @id @default(autoincrement())
  purchaseInvoiceId Int             @map("purchase_invoice_id")
  paymentTypeId     Int             @map("payment_type_id")
  amount            Decimal         @db.Decimal(10, 2)
  paidAt            DateTime        @default(now()) @map("paid_at") @db.Timestamp(6)
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  paymentType       PaymentType     @relation(fields: [paymentTypeId], references: [id], onDelete: Restrict)

  @@index([purchaseInvoiceId], map: "idx_purchase_payment_invoice")
  @@index([paymentTypeId], map: "idx_purchase_payment_type")
  @@map("purchase_payment")
}

model Transformation {
  id         Int                  @id @default(autoincrement())
  employeeId Int                  @map("employee_id")
  date       DateTime             @default(now()) @db.Timestamp(6)
  notes      String?              @db.VarChar(200)
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items      TransformationItem[]

  @@index([employeeId], map: "idx_transformation_employee")
  @@map("transformation")
}

model TransformationItem {
  id                 Int                 @id @default(autoincrement())
  transformationId   Int                 @map("transformation_id")
  supplyId           Int                 @map("supply_id")
  itemType           String              @map("item_type") @db.VarChar(10)
  quantity           Decimal             @db.Decimal(10, 2)
  unitCost           Decimal?            @map("unit_cost") @db.Decimal(10, 2)
  transformation     Transformation      @relation(fields: [transformationId], references: [id], onDelete: Cascade)
  supply             Supply              @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]

  @@index([transformationId], map: "idx_transformation_item_transformation")
  @@index([supplyId], map: "idx_transformation_item_supply")
  @@map("transformation_item")
}

model TransformationRecipe {
  id               Int     @id @default(autoincrement())
  producedSupplyId Int     @map("produced_supply_id")
  consumedSupplyId Int     @map("consumed_supply_id")
  producedQuantity Decimal @default(1) @map("produced_quantity") @db.Decimal(10, 2)
  requiredQuantity Decimal @map("required_quantity") @db.Decimal(10, 2)
  active           Boolean @default(true)
  producedSupply   Supply  @relation("RecipeProduced", fields: [producedSupplyId], references: [id], onDelete: Restrict)
  consumedSupply   Supply  @relation("RecipeConsumed", fields: [consumedSupplyId], references: [id], onDelete: Restrict)

  @@unique([producedSupplyId, consumedSupplyId], map: "uq_transformation_recipe")
  @@index([producedSupplyId], map: "idx_transformation_recipe_produced")
  @@index([consumedSupplyId], map: "idx_transformation_recipe_consumed")
  @@map("transformation_recipe")
}

model InformalPurchase {
  id                    Int                 @id @default(autoincrement())
  supplyId              Int                 @map("supply_id")
  employeeId            Int                 @map("employee_id")
  quantity              Decimal             @db.Decimal(10, 2)
  amountPaid            Decimal             @map("amount_paid") @db.Decimal(10, 2)
  date                  DateTime            @default(now()) @db.Date
  informalPlaceOrVendor String?             @map("informal_place_or_vendor") @db.VarChar(150)
  reason                String?             @db.VarChar(150)
  supply                Supply              @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  inventoryMovements    InventoryMovement[]

  @@index([supplyId], map: "idx_informal_purchase_supply")
  @@index([employeeId], map: "idx_informal_purchase_employee")
  @@map("informal_purchase")
}

// =====================================================================
// MODULE 4: SALES & CUSTOMER SERVICE
// =====================================================================

model Customer {
  id             Int            @id @default(autoincrement())
  documentNumber String         @map("document_number") @db.VarChar(11)
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String?        @map("last_name") @db.VarChar(100)
  phone          String?        @db.VarChar(20)
  personType     PersonType     @default(Natural) @map("person_type")
  active         Boolean        @default(true)
  salesInvoices  SalesInvoice[]

  @@unique([personType, documentNumber], map: "uq_customer_document")
  @@map("customer")
}

model DiningTable {
  id       Int          @id @default(autoincrement())
  number   Int          @unique @db.SmallInt
  capacity Int          @default(4) @db.SmallInt
  active   Boolean      @default(true)
  orders   OrderTable[]

  @@map("dining_table")
}

model Dish {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(100)
  description String?      @db.Text
  price       Decimal      @db.Decimal(7, 2)
  active      Boolean      @default(true)
  orderItems  OrderItem[]
  recipes     DishRecipe[]

  @@map("dish")
}

model DishRecipe {
  id               Int     @id @default(autoincrement())
  dishId           Int     @map("dish_id")
  supplyId         Int     @map("supply_id")
  quantityRequired Decimal @map("quantity_required") @db.Decimal(10, 2)
  dish             Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  supply           Supply  @relation(fields: [supplyId], references: [id], onDelete: Restrict)

  @@unique([dishId, supplyId], map: "uq_dish_recipe_supply")
  @@index([dishId], map: "idx_dish_recipe_dish")
  @@index([supplyId], map: "idx_dish_recipe_supply")
  @@map("dish_recipe")
}

model SalesOrder {
  id            Int            @id @default(autoincrement())
  code          String         @unique @db.VarChar(20)
  orderType     String         @map("order_type") @db.VarChar(10)
  orderedAt     DateTime       @default(now()) @map("ordered_at") @db.Timestamp(6)
  status        String         @default("Pending") @db.VarChar(15)
  tables        OrderTable[]
  items         OrderItem[]
  salesInvoices SalesInvoice[]

  @@map("sales_order")
}

model OrderTable {
  id      Int         @id @default(autoincrement())
  tableId Int         @map("table_id")
  orderId Int         @map("order_id")
  notes   String?     @db.VarChar(100)
  table   DiningTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  order   SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tableId], map: "idx_order_table_table")
  @@index([orderId], map: "idx_order_table_order")
  @@map("order_table")
}

model OrderItem {
  id                 Int                 @id @default(autoincrement())
  orderId            Int                 @map("order_id")
  dishId             Int                 @map("dish_id")
  quantity           Int                 @db.SmallInt
  unitPrice          Decimal             @map("unit_price") @db.Decimal(10, 2)
  subtotal           Decimal             @db.Decimal(10, 2)
  dishStatus         String              @default("Pending") @map("dish_status") @db.VarChar(30)
  notes              String?             @db.VarChar(100)
  order              SalesOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish               Dish                @relation(fields: [dishId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]

  @@index([orderId], map: "idx_order_item_order")
  @@index([dishId], map: "idx_order_item_dish")
  @@map("order_item")
}

model SalesInvoice {
  id             Int            @id @default(autoincrement())
  orderId        Int            @map("order_id")
  customerId     Int            @map("customer_id")
  voucherType    String         @map("voucher_type") @db.VarChar(10)
  series         String         @db.VarChar(4)
  number         Int
  issuedAt       DateTime       @default(now()) @map("issued_at") @db.Date
  subtotal       Decimal        @default(0) @db.Decimal(10, 2)
  igv            Decimal        @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal        @default(0) @map("total_amount") @db.Decimal(10, 2)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  status         String         @default("Issued") @db.VarChar(15)
  s3Url          String?        @map("s3_url") @db.VarChar(300)
  order          SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments       SalesPayment[]
  journalEntries JournalEntry[]
  cashSessionId  Int?           @map("cash_session_id")
  cashSession    CashSession?   @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  @@unique([voucherType, series, number], map: "uq_sales_invoice")
  @@index([orderId], map: "idx_sales_invoice_order")
  @@index([customerId], map: "idx_sales_invoice_customer")
  @@index([cashSessionId], map: "idx_sales_invoice_cash_session")
  @@map("sales_invoice")
}

model SalesPayment {
  id             Int          @id @default(autoincrement())
  salesInvoiceId Int          @map("sales_invoice_id")
  paymentTypeId  Int          @map("payment_type_id")
  amount         Decimal      @db.Decimal(7, 2)
  paidAt         DateTime     @default(now()) @map("paid_at") @db.Timestamp(6)
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  paymentType    PaymentType  @relation(fields: [paymentTypeId], references: [id], onDelete: Restrict)

  @@index([salesInvoiceId], map: "idx_sales_payment_invoice")
  @@index([paymentTypeId], map: "idx_sales_payment_type")
  @@map("sales_payment")
}

// =====================================================================
// MODULE 5: ACCOUNTING
// =====================================================================

model AccountingAccount {
  id            Int                  @id @default(autoincrement())
  parentId      Int?                 @map("parent_id")
  code          String               @unique @db.VarChar(10)
  name          String               @db.VarChar(100)
  type          String               @db.VarChar(20)
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime             @default(now()) @map("updated_at") @db.Timestamp(6)
  parentAccount AccountingAccount?   @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  childAccounts AccountingAccount[]  @relation("AccountHierarchy")
  entryDetails  JournalEntryDetail[]

  @@index([parentId], map: "idx_accounting_account_parent")
  @@map("accounting_account")
}

enum PeriodStatus {
  OPEN
  CLOSED
}

model AccountingPeriod {
  id             Int            @id @default(autoincrement())
  startDate      DateTime       @map("start_date")
  endDate        DateTime       @map("end_date")
  status         PeriodStatus   @default(OPEN)
  closedAt       DateTime?      @map("closed_at")
  closedById     Int?           @map("closed_by_id")
  closedBy       User?          @relation("ClosedPeriods", fields: [closedById], references: [id])
  journalEntries JournalEntry[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")
  user           User?          @relation(fields: [userId], references: [id])
  userId         Int?

  @@map("accounting_period")
}

model JournalEntry {
  id                Int                  @id @default(autoincrement())
  salesInvoiceId    Int?                 @map("sales_invoice_id")
  purchaseInvoiceId Int?                 @map("purchase_invoice_id")
  payrollId         Int?                 @map("payroll_id")
  entryDate         DateTime             @default(now()) @map("entry_date") @db.Date
  periodId          Int                  @map("period_id")
  period            AccountingPeriod     @relation(fields: [periodId], references: [id])
  description       String               @db.VarChar(200)
  book              String               @default("Operaciones varias") @db.VarChar(60)
  responsible       String?              @db.VarChar(100)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime             @default(now()) @map("updated_at") @db.Timestamp(6)
  status            Boolean              @default(true)
  code              String               @unique @db.VarChar(20)
  observation       String?              @db.VarChar(200)
  salesInvoice      SalesInvoice?        @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  purchaseInvoice   PurchaseInvoice?     @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)
  payroll           Payroll?             @relation(fields: [payrollId], references: [id], onDelete: Restrict)
  entryDetails      JournalEntryDetail[]

  @@index([salesInvoiceId], map: "idx_journal_entry_sales_invoice")
  @@index([purchaseInvoiceId], map: "idx_journal_entry_purchase_invoice")
  @@index([periodId], map: "idx_journal_entry_period")
  @@index([payrollId], map: "idx_journal_entry_payroll")
  @@index([entryDate], map: "idx_journal_entry_date")
  @@index([book], map: "idx_journal_entry_book")
  @@index([status], map: "idx_journal_entry_status")
  @@map("journal_entry")
}

model JournalEntryDetail {
  id          Int               @id @default(autoincrement())
  entryId     Int               @map("entry_id")
  accountId   Int               @map("account_id")
  description String?           @db.VarChar(200)
  debit       Decimal           @default(0) @db.Decimal(12, 2)
  credit      Decimal           @default(0) @db.Decimal(12, 2)
  entry       JournalEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId], map: "idx_journal_entry_detail_entry")
  @@index([accountId], map: "idx_journal_entry_detail_account")
  @@map("journal_entry_detail")
}

// =====================================================================
// MODULE 6: CASH REGISTER & CASH SESSIONS (APERTURA Y CIERRE DE CAJA)
// =====================================================================

enum CashSessionStatus {
  OPEN
  CLOSED

  @@map("cash_session_status")
}

enum CashMovementType {
  INCOME
  EXPENSE

  @@map("cash_movement_type")
}

model CashRegister {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(50)
  code        String        @unique @db.VarChar(20)
  description String?       @db.VarChar(150)
  active      Boolean       @default(true)
  sessions    CashSession[]

  @@map("cash_register")
}

model CashSession {
  id             Int               @id @default(autoincrement())
  cashRegisterId Int               @map("cash_register_id")
  openedById     Int               @map("opened_by_id")
  closedById     Int?              @map("closed_by_id")
  openedAt       DateTime          @default(now()) @map("opened_at") @db.Timestamp(6)
  closedAt       DateTime?         @map("closed_at") @db.Timestamp(6)
  initialAmount  Decimal           @default(0) @map("initial_amount") @db.Decimal(10, 2)
  salesCash      Decimal           @default(0) @map("sales_cash") @db.Decimal(10, 2)
  salesOther     Decimal           @default(0) @map("sales_other") @db.Decimal(10, 2)
  totalSales     Decimal           @default(0) @map("total_sales") @db.Decimal(10, 2)
  expectedAmount Decimal?          @map("expected_amount") @db.Decimal(10, 2)
  countedAmount  Decimal?          @map("counted_amount") @db.Decimal(10, 2)
  difference     Decimal?          @map("difference") @db.Decimal(10, 2)
  status         CashSessionStatus @default(OPEN)
  notesOpening   String?           @map("notes_opening") @db.VarChar(255)
  notesClosing   String?           @map("notes_closing") @db.VarChar(255)

  cashRegister   CashRegister      @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  openedBy       User              @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy       User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  movements      CashMovement[]
  salesInvoices  SalesInvoice[]

  @@index([cashRegisterId], map: "idx_cash_session_register")
  @@index([openedById], map: "idx_cash_session_opened_by")
  @@index([status], map: "idx_cash_session_status")
  @@map("cash_session")
}

model CashMovement {
  id        Int              @id @default(autoincrement())
  sessionId Int              @map("session_id")
  type      CashMovementType
  amount    Decimal          @db.Decimal(10, 2)
  reason    String           @db.VarChar(150)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  session   CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "idx_cash_movement_session")
  @@map("cash_movement")
}

