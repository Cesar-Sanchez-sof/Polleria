    { "id": "binario-2.675", "type": "Activo", "debit": "2.675", "credit": "0", "py_expected": "2.68", "js_expected": "2.68", "diverges": false, "reason": "En coma flotante 2.675 * 100 = 267.5 exacto, así que Math.round coincide (el error clásico de 2.675 es de toFixed, no de Math.round)" },
