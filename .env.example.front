# CONFIGURACIÓN DE BASE DE DATOS (NEON POSTGRESQL)
DATABASE_URL=

# AUTENTICACIÓN Y SEGURIDAD
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=

# CONSULTA DE DOCUMENTOS (DNI / RUC - json.pe)
JSON_PE_TOKEN=

# ALMACENAMIENTO DE COMPROBANTES (S3 / NEON OBJECT STORAGE / CLOUDFLARE R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ENDPOINT_URL_S3=

# PASARELA DE PAGO (MERCADO PAGO)
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# ==============================================================================
# CACHE / RATE LIMITING (UPSTASH REDIS)
# ==============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================================================================
# ASISTENTE DE IA (el globo aparece siempre; sin modelos muestra "No hay modelos disponibles")
# ==============================================================================
# Los interruptores (demostración, evaluación, datos reales, diagnóstico, agentes Gemini/Groq, Modelo R y
# dictado por voz) ya no son variables de entorno: se encienden en Configuración → Desarrollador y se guardan
# en la tabla developer_setting. Aquí quedan solo las claves, tokens y URLs.
# --- Modelo R (LoRA / ai-service) ---
# Local: http://127.0.0.1:<puerto>. Evaluación: túnel https (trycloudflare o ngrok del proyecto)
AI_SERVICE_URL=
# Hex de 32 bytes o más (64+ caracteres); el mismo valor que usa ai-service
AI_SERVICE_INTERNAL_TOKEN=
# Hex de 32 bytes o más, distinta del token interno (firma la identidad de cada consulta)
AI_ASSISTANT_IDENTITY_KEY=
# Ids de usuario ADMIN evaluadores separados por comas (obligatorio en Vercel con datos reales)
AI_ASSISTANT_EVAL_USER_IDS=

# --- Agentes de SOLO LECTURA sobre el ERP (opciones "Gemini" y "GPT-OSS 120B (Groq)" del selector) ---
# Viven en agents-service (carpeta agents-service/, se despliega aparte en Render), separado de ai-service.
# El LLM solo ve el esquema permitido; agents-service valida el SELECT y lo ejecuta con el rol ai_readonly.
# Cada servicio tiene su propia URL y token: se puede usar uno, el otro o ambos.
# Render: https://<servicio>.onrender.com (sin puerto ni ruta). Local (solo con el interruptor de demostración): http://127.0.0.1:8002
AGENTS_SERVICE_URL=
# Hex de 32 bytes o más, distinto de AI_ASSISTANT_IDENTITY_KEY; el mismo valor que AGENTS_SERVICE_INTERNAL_TOKEN en agents-service
AGENTS_SERVICE_INTERNAL_TOKEN=
# Las opciones del selector se encienden en Configuración → Desarrollador (Agente Gemini, Agente GPT OSS, Modelo R);
# además hace falta la clave de cada agente (GEMINI_API_KEY / GROQ_API_KEY) en el entorno de agents-service.
# Exigen AI_ASSISTANT_IDENTITY_KEY (P-9), con el mismo valor que en agents-service.

# --- Dictado por voz del asistente (opcional; el audio se envía a Groq, un tercero) ---
# Whisper en Groq: botón de micrófono en el chat. El texto se escribe en la caja; nunca se envía solo.
# Apagado por defecto: tener GROQ_API_KEY no basta, hace falta el interruptor «Dictado por voz» (Configuración → Desarrollador).
# La misma clave del agente Groq (console.groq.com); aquí la necesita Next.js (en Vercel), no solo agents-service
GROQ_API_KEY=

# --- ai-service (Python, solo Modelo R): variables del servicio, no de Next.js ---
# Se definen en el entorno de ai-service o en ai-service/.env (ignorado por git), no aquí.
# Intérprete del resultado del LoRA: simulado (por defecto) u openai (con openai, OPENAI_API_KEY y OPENAI_MODEL van allí también)
AI_LLM_PROVIDER=
AI_SQL_GENERATOR=
# Variables de agents-service (GEMINI_API_KEY, GROQ_API_KEY, DATABASE_URL_READONLY, timeouts...): ver agents-service/.env.example

# ==============================================================================
# FACTURACIÓN ELECTRÓNICA SUNAT (UBL 2.1)
# ==============================================================================
# RUC del emisor para pruebas (Default: 20000000001)
SUNAT_RUC=20000000001
# Usuario y clave secundarios SOL para entorno Beta de SUNAT
SUNAT_USER=MODDATOS
SUNAT_PASSWORD=moddatos
# Web Service Beta de SUNAT para emisión de comprobantes
SUNAT_ENDPOINT=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
# (Opcional) Certificado digital .pem para producción (en Beta se genera par demo en memoria)
SUNAT_CERT_PEM=
SUNAT_PRIVATE_KEY_PEM=
